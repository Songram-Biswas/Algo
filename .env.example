# Copy this file to .env for local development (.env is gitignored).
# On Vercel, set these under Project Settings → Environment Variables.

# AI Tutor: Google Gemini API key (Required for /api/ai-tutor)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Supabase Auth & Database (Required for /api/ai-tutor session verification)
SUPABASE_URL=https://hqbkdivhdotpshgrkrmg.supabase.co
SUPABASE_ANON_KEY=sb_publishable_Omm-F1aXRg3iENefV0uteg_a1jzEYdh

# Supabase Admin / Service Role Key (Required for /api/reminders to fetch users)
# Find in: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security for Daily Reminders Cron
# Optional: Set this to secure /api/reminders (Vercel Cron sends this header)
# CRON_SECRET=your-random-cron-secret-here

# Optional: Email dispatch for reminders (e.g. Resend)
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=AlgoHub <reminders@algohub.dev>
# SITE_URL=http://localhost:3000
